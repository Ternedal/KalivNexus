# Generate a long random token, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Optional: SQLite path (default ./data/nexus.db; the container uses /data/nexus.db)
# NEXUS_DB=./data/nexus.db
# Opt-in experimental HTTP GET executor; must be exactly "true". Leave unset.
# NEXUS_ENABLE_HTTP_EXECUTION=true
# Egress relay (python -m nexus.egress_proxy / compose.egress.yaml) only:
# NEXUS_PROXY_ORIGIN=https://approved.example.org/mcp
# NEXUS_PROXY_SECRET=<random, at least 32 characters>
